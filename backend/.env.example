# ─── База данных ───
# SQLite (по умолчанию, не нужно устанавливать ничего):
DATABASE_URL=sqlite:///./kyrgyzkomur.db

# PostgreSQL (для продакшена):
# DATABASE_URL=postgresql://user:password@localhost:5432/kyrgyzkomur

# ─── JWT ───
SECRET_KEY=kyrgyzkomur-super-secret-key-change-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS (разрешённые фронтенд адреса через запятую) ───
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Сервер ───
HOST=0.0.0.0
PORT=5000
